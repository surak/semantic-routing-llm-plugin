+                plugins = {
+                    ["ai-proxy-multi"] = {
+                        balancer = { algorithm = "system_one" },
+                        system_one_opts = {
+                            endpoint = "http://127.0.0.1:6796/v1/systemone",
+                            model = "jev-latest",
+                            fallback = "default",
+                        },
+                        fallback_strategy = { "rate_limiting" },
+                        instances = {
